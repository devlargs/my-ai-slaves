{
  "name": "my-ai-slaves",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @my-ai-slaves/server",
    "build": "npm run build --workspace @my-ai-slaves/web",
    "start": "npm run start --workspace @my-ai-slaves/server",
    "desktop": "npm run build && npm run stage --workspace @my-ai-slaves/desktop && electron packages/desktop/app",
    "desktop:dist": "npm run build && npm run stage --workspace @my-ai-slaves/desktop && npm run dist --workspace @my-ai-slaves/desktop --",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "npm run test --workspace @my-ai-slaves/server --workspace @my-ai-slaves/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "data:init": "npm run data:init --workspace @my-ai-slaves/server",
    "data:demo-activity": "npm run data:demo-activity --workspace @my-ai-slaves/server --",
    "prompt:preview": "npm run prompt:preview --workspace @my-ai-slaves/server --"
  }
}
