{
  "name": "my-ai-slaves",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @my-ai-slaves/server",
    "build": "npm run build --workspace @my-ai-slaves/web",
    "start": "npm run start --workspace @my-ai-slaves/server",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "test": "npm run test --workspace @my-ai-slaves/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "data:init": "npm run data:init --workspace @my-ai-slaves/server",
    "data:demo-activity": "npm run data:demo-activity --workspace @my-ai-slaves/server --",
    "prompt:preview": "npm run prompt:preview --workspace @my-ai-slaves/server --"
  }
}
